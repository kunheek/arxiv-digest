# Copy to .env (same folder) and fill in.   cp .env.example .env && chmod 600 .env
# .env is git-ignored, so these never leave your machine.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: Discord notifications (digest + failure alerts)
DISCORD_WEBHOOK=https://discord.com/api/webhooks/...

# Optional: push liked/bookmarked papers to Zotero. Create a key with write access at
# https://www.zotero.org/settings/keys  (ZOTERO_USER_ID is optional: it's looked up from the key)
ZOTERO_API_KEY=
ZOTERO_USER_ID=

# Optional: set to 0 to stop `git pull` before each run
AUTO_PULL=1
